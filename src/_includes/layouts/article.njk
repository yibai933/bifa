---
layout: layouts/base.njk
---
<section class="article-page">
  <div class="wrap">
    <a class="article-back" href="/#articles"><span class="arr">←</span> 返回文章</a>
    <header class="article-head">
      <span class="cat-chip">{{ category }}</span>
      <h1>{{ title }}</h1>
      <div class="ameta">
        <span>{{ readTime }} 分钟</span><span class="dot"></span>
        <span>{{ level }}</span><span class="dot"></span>
        <span>{{ date | dateFilter }}</span>
      </div>
    </header>
    {% if coverImage %}
    <figure class="article-cover" data-component="article-cover">
      <img src="{{ coverImage }}" alt="{{ title }}" loading="lazy">
    </figure>
    {% elif figure == "story-arc" %}
    <figure class="article-cover lead-fig" data-component="article-cover">
      {% include "partials/figure-story-arc.njk" %}
    </figure>
    {% else %}
    <figure class="article-cover" data-component="article-cover" data-cat="{{ category }}">
      {% set coverCat = category %}
      {% set coverTitle = title %}
      {% set size = "full" %}
      {% include "partials/cover-figure.njk" %}
    </figure>
    {% endif %}
    <article class="article-body">
      {{ content | safe }}
    </article>
  </div>
</section>
