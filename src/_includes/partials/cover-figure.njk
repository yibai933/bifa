{# 头图组件：coverImage 有值时用图片，否则按分类自动生成 SVG 图案 #}
{# 用法：{% set articleData = a.data or page %} 然后 {% include "partials/cover-figure.njk" %} #}
{# 可选变量：coverClass（容器类名）、coverSize（"full"|"thumb"） #}

{% set coverCat = category or articleData.category or "" %}
{% set coverTitle = title or articleData.title or "" %}
{% set coverImg = coverImage or articleData.coverImage or "" %}
{% set coverFig = figure or articleData.figure or "" %}
{% set size = coverSize or "full" %}
{% set vb = size == "thumb" ? "0 0 400 200" : "0 0 800 300" %}

{% if coverImg %}
  <div class="cover-figure{{ " " ~ coverClass if coverClass }}" data-component="cover-figure">
    <img src="{{ coverImg }}" alt="{{ coverTitle }}" loading="lazy">
  </div>
{% elif coverFig == "story-arc" %}
  {# 保留已有的 story-arc SVG，不额外生成 #}
{% else %}
  {# 按分类生成 SVG 图案 #}
  <div class="cover-figure{{ " " ~ coverClass if coverClass }}" data-component="cover-figure" data-cat="{{ coverCat }}">
    <svg viewBox="{{ vb }}" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      {% if coverCat == "人物塑造" %}
        {# 同心圆 · 人物深度 #}
        <rect width="100%" height="100%" fill="#fdf2e9"/>
        <circle cx="50%" cy="50%" r="42%" fill="none" stroke="#e87b3e" stroke-width="1.5" opacity="0.3"/>
        <circle cx="50%" cy="50%" r="32%" fill="none" stroke="#d4632a" stroke-width="1.5" opacity="0.5"/>
        <circle cx="50%" cy="50%" r="22%" fill="none" stroke="#b54a1a" stroke-width="2" opacity="0.7"/>
        <circle cx="50%" cy="50%" r="12%" fill="#b54a1a" opacity="0.85"/>
        <text x="5%" y="92%" font-family="ui-monospace,monospace" font-size="11" fill="#b54a1a" opacity="0.5">CHARACTER · 人物</text>

      {% elif coverCat == "情节结构" %}
        {# 上升弧线 · 叙事弧 #}
        <rect width="100%" height="100%" fill="#eef4fb"/>
        <path d="M0,260 Q200,240 400,120 T800,40" fill="none" stroke="#1d70b8" stroke-width="2.5" opacity="0.8"/>
        <path d="M0,260 Q200,240 400,120 T800,40 L800,300 L0,300 Z" fill="#1d70b8" opacity="0.06"/>
        <line x1="0" y1="260" x2="800" y2="260" stroke="#1d70b8" stroke-width="1" opacity="0.3"/>
        <circle cx="400" cy="120" r="5" fill="#1d70b8"/>
        <line x1="400" y1="120" x2="400" y2="80" stroke="#1d70b8" stroke-width="1" opacity="0.5"/>
        <text x="410" y="76" font-family="ui-monospace,monospace" font-size="11" fill="#1d70b8">高潮</text>
        <text x="5%" y="92%" font-family="ui-monospace,monospace" font-size="11" fill="#1d70b8" opacity="0.5">PLOT · 情节</text>

      {% elif coverCat == "世界观构建" %}
        {# 网格 · 世界地图 #}
        <rect width="100%" height="100%" fill="#edf6ee"/>
        <defs><pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M40,0 L0,0 L0,40" fill="none" stroke="#2e7d32" stroke-width="0.8" opacity="0.25"/>
        </pattern></defs>
        <rect width="100%" height="100%" fill="url(#grid)"/>
        <path d="M120,80 L280,60 L380,120 L320,220 L180,200 L100,160 Z" fill="#2e7d32" opacity="0.06" stroke="#2e7d32" stroke-width="1.5" opacity="0.4"/>
        <circle cx="250" cy="140" r="4" fill="#2e7d32" opacity="0.6"/>
        <circle cx="520" cy="100" r="3" fill="#2e7d32" opacity="0.5"/>
        <circle cx="640" cy="200" r="5" fill="#2e7d32" opacity="0.7"/>
        <text x="5%" y="92%" font-family="ui-monospace,monospace" font-size="11" fill="#2e7d32" opacity="0.5">WORLD · 世界观</text>

      {% elif coverCat == "对话写作" %}
        {# 交叉气泡 · 对话 #}
        <rect width="100%" height="100%" fill="#f3eef8"/>
        <path d="M80,60 Q80,30 130,30 L250,30 Q300,30 300,60 L300,110 Q300,140 250,140 L180,140 L150,170 L160,140 L130,140 Q80,140 80,110 Z" fill="#6b3fa0" opacity="0.12" stroke="#6b3fa0" stroke-width="1.5" opacity="0.3"/>
        <path d="M400,100 Q400,70 450,70 L620,70 Q670,70 670,100 L670,150 Q670,180 620,180 L520,180 L490,210 L500,180 L450,180 Q400,180 400,150 Z" fill="#8e44ad" opacity="0.1" stroke="#8e44ad" stroke-width="1.5" opacity="0.25"/>
        <text x="5%" y="92%" font-family="ui-monospace,monospace" font-size="11" fill="#6b3fa0" opacity="0.5">DIALOGUE · 对话</text>

      {% elif coverCat == "叙事节奏" %}
        {# 波浪 · 节奏 #}
        <rect width="100%" height="100%" fill="#e8f5f4"/>
        <path d="M0,150 Q100,80 200,150 T400,150 T600,150 T800,150" fill="none" stroke="#0d7d74" stroke-width="2" opacity="0.6"/>
        <path d="M0,200 Q100,120 200,200 T400,200 T600,200 T800,200" fill="none" stroke="#0d7d74" stroke-width="1.5" opacity="0.4"/>
        <path d="M0,100 Q100,40 200,100 T400,100 T600,100 T800,100" fill="none" stroke="#0d7d74" stroke-width="1" opacity="0.25"/>
        <text x="5%" y="92%" font-family="ui-monospace,monospace" font-size="11" fill="#0d7d74" opacity="0.5">PACING · 节奏</text>

      {% elif coverCat == "修改方法" %}
        {# 删除线 · 修订 #}
        <rect width="100%" height="100%" fill="#fdf6e8"/>
        <line x1="60" y1="70" x2="280" y2="70" stroke="#b5860b" stroke-width="2" opacity="0.3"/>
        <line x1="60" y1="70" x2="280" y2="70" stroke="#d4351c" stroke-width="2" opacity="0.5"/>
        <line x1="320" y1="110" x2="620" y2="110" stroke="#b5860b" stroke-width="2" opacity="0.3"/>
        <line x1="320" y1="110" x2="620" y2="110" stroke="#d4351c" stroke-width="2" opacity="0.5"/>
        <line x1="100" y1="160" x2="480" y2="160" stroke="#b5860b" stroke-width="2" opacity="0.3"/>
        <line x1="100" y1="160" x2="480" y2="160" stroke="#d4351c" stroke-width="2" opacity="0.5"/>
        <path d="M540,130 L560,150 L600,110" fill="none" stroke="#00703c" stroke-width="2.5" opacity="0.6"/>
        <text x="5%" y="92%" font-family="ui-monospace,monospace" font-size="11" fill="#b5860b" opacity="0.5">REVISION · 修改</text>

      {% elif coverCat == "作者SOP" %}
        {# 文档 · 方法论 #}
        <rect width="100%" height="100%" fill="#eceef1"/>
        <rect x="80" y="40" width="180" height="220" fill="#3e4a5d" opacity="0.06" stroke="#3e4a5d" stroke-width="1.5" opacity="0.2"/>
        <line x1="100" y1="70" x2="240" y2="70" stroke="#3e4a5d" stroke-width="2" opacity="0.2"/>
        <line x1="100" y1="100" x2="220" y2="100" stroke="#3e4a5d" stroke-width="2" opacity="0.2"/>
        <line x1="100" y1="130" x2="240" y2="130" stroke="#3e4a5d" stroke-width="2" opacity="0.2"/>
        <line x1="100" y1="160" x2="200" y2="160" stroke="#3e4a5d" stroke-width="2" opacity="0.2"/>
        <line x1="100" y1="190" x2="230" y2="190" stroke="#3e4a5d" stroke-width="2" opacity="0.2"/>
        <rect x="340" y="40" width="180" height="220" fill="#3e4a5d" opacity="0.04" stroke="#3e4a5d" stroke-width="1.5" opacity="0.15"/>
        <line x1="360" y1="70" x2="500" y2="70" stroke="#3e4a5d" stroke-width="2" opacity="0.15"/>
        <line x1="360" y1="100" x2="480" y2="100" stroke="#3e4a5d" stroke-width="2" opacity="0.15"/>
        <line x1="360" y1="130" x2="500" y2="130" stroke="#3e4a5d" stroke-width="2" opacity="0.15"/>
        <text x="5%" y="92%" font-family="ui-monospace,monospace" font-size="11" fill="#3e4a5d" opacity="0.5">SOP · 作者方法</text>

      {% else %}
        {# 默认 · 网格纸 #}
        <rect width="100%" height="100%" fill="#f3f2f1"/>
        <defs><pattern id="defgrid" width="30" height="30" patternUnits="userSpaceOnUse">
          <path d="M30,0 L0,0 L0,30" fill="none" stroke="#0b0c0c" stroke-width="0.6" opacity="0.08"/>
        </pattern></defs>
        <rect width="100%" height="100%" fill="url(#defgrid)"/>
        <text x="5%" y="92%" font-family="ui-monospace,monospace" font-size="11" fill="#0b0c0c" opacity="0.3">BIFA · 笔法</text>
      {% endif %}
    </svg>
  </div>
{% endif %}
